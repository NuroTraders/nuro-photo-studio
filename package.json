{
  "name": "nuro-photo-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first photo editing foundation for browser/PWA and Windows desktop.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test scripts/test-image-loader.mjs scripts/test-viewport.mjs scripts/test-transform.mjs scripts/test-crop.mjs scripts/test-history.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env NPS_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder --win nsis",
    "check": "node scripts/check-project.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  }
}
